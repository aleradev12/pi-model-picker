{
  "name": "pi-model-picker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A grouped, searchable, keyboard-first model picker for Pi",
  "keywords": [
    "pi-package",
    "pi-extension",
    "model-picker"
  ],
  "pi": {
    "extensions": [
      "./dist/new-model-picker.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/core.test.ts",
    "check": "node scripts/check.mjs",
    "bundle": "node scripts/bundle.mjs",
    "smoke:bundle": "node scripts/smoke-bundle.mjs",
    "verify": "npm run check && npm run test && npm run bundle && npm run smoke:bundle",
    "prepare": "npm run bundle"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1"
  }
}
